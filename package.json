{
  "name": "bsr-modaldialog",
  "version": "3.1.0",
  "description": " react async dialog",
  "author": "ionson100",
  "license": "MIT",
  "keywords": ["async dialog","dialog","modal dialog"],
  "repository": "https://github.com/ionson100/bsr-modaldialog",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/ionson100/bsr-modaldialog",
  "sideEffects": ["**/*.css"],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },

  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },

  "dependencies": {
    "react-icons": "^5.2.1"
  },

  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && rollup -c --bundleConfigAsCjs && node scripts/copy-css.mjs",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test --test-force-exit \"test/*.test.cjs\" \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },

  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.13.0",
    "jsdom": "^24.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "4.37.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.0.0"
  }
}
